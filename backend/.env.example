# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/vook
# Set true in staging/production because payroll/company workflows use transactions.
REQUIRE_MONGODB_REPLICA_SET=false

# JWT secrets — change these in production (use long random strings)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Razorpay checkout (leave blank until online billing is enabled)
RAZORPAY_KEY_ID=rzp_test_TSKW8TKt5lNuce
